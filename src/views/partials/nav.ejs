<header>
    <nav>
        <div class="flex-row-center-center" id="nav-sub-navbar">

        </div>
        <div class="flex-row-center-center nav-dashboard-subcontainer">
            <div class="nav-dashboard" id="nav-logo">
                <i class="fa fa-plus-square" aria-hidden="true"></i>
                <h1>Farmacy</h1>
            </div>
            <ul class="flex-row-center-center">
                <li><a href="/">Ver productos</a></li>
                <li><a href="/consultar">Consultar</a></li>
                <li><a href="/crear">Crear</a></li>
                <li><a href="/modificar">Modificar</a></li>
                <li><a href="/eliminar">Eliminar</a></li>
            </ul>

            <div class="nav-item-container">
                <i onclick="menuDropDown(event)" class="fa fa-bars menu-dropdown-nav" aria-hidden="true"></i>

                <div id="menu-mobile">
                    <p class="menu-mobile-a"><a href="/">Ver productos</a></p>
                    <p class="menu-mobile-a"><a href="/consultar">Consultar</a></p>
                    <p class="menu-mobile-a"><a href="/crear">Crear</a></p>
                    <p class="menu-mobile-a"><a href="/modificar">Modificar</a></p>
                    <p class="menu-mobile-a"><a href="/eliminar">Eliminar</a></p>
                </div>
            </div>


            <form action="/logout" id="logout" method="POST">
                <button type="submit" id="button-logout">
                    <span id="cerrar-sesion">Cerrar sesión</span>
                    <i class="fa fa-sign-out" aria-hidden="true"></i>
                </button>
            </form>

        </div>
    </nav>
    <script>
        const menuMobile = document.getElementById('menu-mobile');
        const links = document.querySelectorAll('#menu-mobile a');

        function menuDropDown(event) {
            if (event) event.stopPropagation();
            menuMobile.classList.toggle('show-menu');
        }

        links.forEach(link => {
            link.addEventListener('click', (e) => {
                e.stopPropagation();
                menuMobile.classList.remove('show-menu');
            });
        });

        window.addEventListener('click', (e) => {
            const icono = document.querySelector('.menu-dropdown-nav');

            if (!menuMobile.contains(e.target) && e.target !== icono) {
                menuMobile.classList.remove('show-menu');
            }
        });
    </script>
</header>